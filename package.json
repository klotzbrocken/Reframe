{
  "name": "reframe",
  "version": "1.15.0",
  "description": "Reframe \u2014 today's web, yesterday's look. A modern Chromium browser wrapped in pixel-faithful retro chrome (IE5, Netscape, Aqua Safari).",
  "author": "Maik Klotz",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "release:prepare": "node build/ensure-release.cjs --create",
    "release": "node build/ensure-release.cjs && electron-vite build && electron-builder --mac --publish always",
    "release:win": "node build/ensure-release.cjs && electron-vite build && electron-builder --win --publish always",
    "package:linux": "electron-vite build && electron-builder --linux",
    "release:linux": "node build/ensure-release.cjs && electron-vite build && electron-builder --linux --publish always",
    "test": "vitest run"
  },
  "build": {
    "appId": "app.myretromac.reframe",
    "productName": "Reframe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/@ghostery/**/*"
    ],
    "electronLanguages": [
      "en",
      "en_US",
      "en_GB",
      "en-US",
      "en-GB",
      "de"
    ],
    "extraResources": [
      "resources/**/*",
      "!resources/app-icons/reframe.icns"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "klotzbrocken",
        "repo": "Reframe"
      }
    ],
    "afterSign": "build/notarize.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Today's web, yesterday's look \u2014 a retro-chrome browser.",
      "target": [
        {
          "target": "AppImage"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reframe"
    },
    "asarUnpack": [
      "node_modules/@ghostery/adblocker-electron-preload/**"
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.9.0",
    "@ghostery/adblocker-electron-preload": "2.18.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
